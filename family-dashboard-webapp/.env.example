# Copy this file to .env and fill in your Supabase project's API credentials.
# Supabase dashboard -> Project Settings -> API -> Project URL / anon public key.
# See MIGRATION.md for the full walkthrough.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Comma-separated. Family members allowed to sign in. Must match
# is_family_member() in supabase/policies.sql exactly.
VITE_ALLOWED_EMAILS=nishb85@gmail.com,sannish16@gmail.com,16marinaclose@gmail.com,hazeldia7@gmail.com,leescu.paul@gmail.com,leescu.paul@googlemail.com

# Comma-separated. Only these can see/edit the Finance tab. Must match
# is_finance_member() in supabase/policies.sql exactly.
VITE_FINANCE_EMAILS=nishb85@gmail.com,sannish16@gmail.com

# Comma-separated. Only these can see/edit the Spending tab. Must match
# is_expense_member() in supabase/policies.sql exactly.
VITE_EXPENSE_EMAILS=nishb85@gmail.com,sannish16@gmail.com,hazeldia7@gmail.com
